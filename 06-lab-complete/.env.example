# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore — KHÔNG commit)
# Trên cloud: đặt các biến này trong dashboard của Railway / Render.

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret — đặt giá trị thật ở .env / dashboard, không ghi vào đây
AGENT_API_KEY=change-me

# docker compose tự đặt REDIS_URL=redis://redis:6379/0 cho service agent
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
